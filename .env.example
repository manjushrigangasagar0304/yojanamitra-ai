# Copy this file to .env and fill in ONE key.

# Option A (default): Google Gemini - free key at https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GOOGLE_API_KEY=your-gemini-key-here
# GEMINI_MODEL=gemini-flash-latest

# Option B: Groq (free, Llama 3.3) - key at https://console.groq.com/keys
# LLM_PROVIDER=groq
# GROQ_API_KEY=your-groq-key-here
